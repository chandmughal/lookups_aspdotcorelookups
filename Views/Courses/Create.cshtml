@model CourseViewModel
@{
    ViewData["Title"] = "Create course";
}

<h2>Course setup</h2>
<p class="text-muted">The form demonstrates static, Oracle-backed, and SQL Server-backed lookup values.</p>

@if (ViewBag.Message is not null)
{
    <div class="alert alert-success">@ViewBag.Message</div>
}

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="Course.CourseName" class="form-label"></label>
        <input asp-for="Course.CourseName" class="form-control" />
        <span asp-validation-for="Course.CourseName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Course.CourseType" class="form-label"></label>
        <select asp-for="Course.CourseType" asp-items="Model.CourseTypes" class="form-select">
            <option value="">-- Select course type --</option>
        </select>
        <span asp-validation-for="Course.CourseType" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Course.Status" class="form-label"></label>
        <select asp-for="Course.Status" asp-items="Model.Statuses" class="form-select">
            <option value="">-- Select status --</option>
        </select>
        <span asp-validation-for="Course.Status" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="SelectedOracleLovCode" class="form-label">Oracle LOV (CLS_TYP = 7)</label>
        <select asp-for="SelectedOracleLovCode" asp-items="Model.OracleLovItems" class="form-select">
            <option value="">-- Select Oracle value --</option>
        </select>
        <small class="form-text text-muted">ITM_COD is submitted; ITM_DESC is displayed.</small>
    </div>

    <hr />
    <h4>SQL Server Job Type LOV</h4>
    <p class="text-muted">Search checks all ten columns. Select a row to return only its JobType value.</p>

    <div class="mb-2">
        <label for="jobTypeSearch" class="form-label">Filter all columns</label>
        <input id="jobTypeSearch" type="search" class="form-control"
               placeholder="Type JobType, description, machine, department, concern..." />
    </div>

    <input asp-for="SelectedJobType" type="hidden" id="SelectedJobType" />

    <div class="mb-2">
        <strong>Selected JobType:</strong>
        <span id="selectedJobTypeText">@(Model.SelectedJobType ?? "None selected")</span>
    </div>

    <div class="table-responsive" style="max-height: 420px; overflow: auto;">
        <table class="table table-sm table-bordered table-hover align-middle" id="jobTypeLovTable">
            <thead class="table-light">
                <tr>
                    <th>JobType</th>
                    <th>JobDescription</th>
                    <th>MachineType</th>
                    <th>CategoryHead</th>
                    <th>Concern</th>
                    <th>TypeStatus</th>
                    <th>CuttingDepartment</th>
                    <th>StitchingDepartment</th>
                    <th>InspectionDepartment</th>
                    <th>PackingDepartment</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model.SqlServerJobTypes)
            {
                <tr>
                    <td>@item.JobType</td>
                    <td>@item.JobDescription</td>
                    <td>@item.MachineType</td>
                    <td>@item.CategoryHead</td>
                    <td>@item.Concern</td>
                    <td>@item.TypeStatus</td>
                    <td>@item.CuttingDepartment</td>
                    <td>@item.StitchingDepartment</td>
                    <td>@item.InspectionDepartment</td>
                    <td>@item.PackingDepartment</td>
                    <td>
                        <button type="button" class="btn btn-sm btn-outline-primary select-job-type"
                                data-jobtype="@item.JobType">Select</button>
                    </td>
                </tr>
            }
            </tbody>
        </table>
        <div id="noJobTypeRows" class="alert alert-warning d-none">No matching Job Types found.</div>
    </div>

    <button type="submit" class="btn btn-primary mt-3">Validate form</button>
</form>

@if (ViewBag.Message is not null)
{
    <hr />
    <h5>Submitted values</h5>
    <dl class="row">
        <dt class="col-sm-3">Course name</dt>
        <dd class="col-sm-9">@Model.Course.CourseName</dd>
        <dt class="col-sm-3">Course type</dt>
        <dd class="col-sm-9">@Model.Course.CourseType</dd>
        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@Model.Course.Status</dd>
        <dt class="col-sm-3">Oracle LOV code</dt>
        <dd class="col-sm-9">@Model.SelectedOracleLovCode</dd>
        <dt class="col-sm-3">SQL Server JobType</dt>
        <dd class="col-sm-9">@Model.SelectedJobType</dd>
    </dl>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const searchBox = document.getElementById("jobTypeSearch");
            const table = document.getElementById("jobTypeLovTable");
            const hiddenValue = document.getElementById("SelectedJobType");
            const selectedText = document.getElementById("selectedJobTypeText");
            const noRows = document.getElementById("noJobTypeRows");

            searchBox.addEventListener("input", () => {
                const term = searchBox.value.trim().toLowerCase();
                let visibleCount = 0;

                table.querySelectorAll("tbody tr").forEach(row => {
                    const matches = row.innerText.toLowerCase().includes(term);
                    row.hidden = !matches;
                    if (matches) visibleCount++;
                });

                noRows.classList.toggle("d-none", visibleCount !== 0);
            });

            table.querySelectorAll(".select-job-type").forEach(button => {
                button.addEventListener("click", () => {
                    hiddenValue.value = button.dataset.jobtype;
                    selectedText.textContent = button.dataset.jobtype;
                    table.querySelectorAll("tbody tr").forEach(row => row.classList.remove("table-primary"));
                    button.closest("tr").classList.add("table-primary");
                });
            });
        })();
    </script>
}